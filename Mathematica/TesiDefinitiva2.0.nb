   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Derivata", " ", "esplicita", " ", "complessa", " ", "del", " ", 
     "potenziale", " ", "W", 
     RowBox[{"(", "z", ")"}], " ", "per", " ", "Dipolo"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"df", "[", 
      RowBox[{"z_", ",", "c_", ",", "d_"}], "]"}], ":=", 
     RowBox[{"I", "*", 
      RowBox[{"(", 
       RowBox[{"c", "-", 
        RowBox[{"c", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", 
             RowBox[{"z", "^", "2"}]}], "-", 
            RowBox[{
             RowBox[{"d", "^", "2"}], "/", "2"}]}], ")"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"z", "^", "2"}], "+", 
             RowBox[{
              RowBox[{"d", "^", "2"}], "/", "4"}]}], ")"}], "^", "2"}]}]}], "+", 
        RowBox[{"d", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"z", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"d", "^", "2"}], "/", "4"}]}], ")"}]}]}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Pre", "-", 
     RowBox[{
     "calcolo", " ", "algebrico", " ", "del", " ", "modulo", " ", "della", " ",
       "velocit\[AGrave]", " ", "al", " ", "quadrato"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"velSqExpr", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"df", "[", 
          RowBox[{
           RowBox[{"x", "+", 
            RowBox[{"I", "*", "y"}]}], ",", "c", ",", "d"}], "]"}], "]"}], "^",
         "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"velSq", "[", 
      RowBox[{"x_", ",", "y_", ",", "c_", ",", "d_"}], "]"}], "=", 
     "velSqExpr"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Definizione", " ", "numerica", " ", "per", " ", "NIntegrate"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"velSq", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}], ",", 
       RowBox[{"c_", "?", "NumericQ"}], ",", 
       RowBox[{"dVal_", "?", "NumericQ"}], ",", 
       RowBox[{"dNew_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"I", "*", 
        RowBox[{"(", 
         RowBox[{"c", "-", 
          RowBox[{"c", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "+", 
                  RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}]}], "-", 
              RowBox[{
               RowBox[{"dNew", "^", "2"}], "/", "2"}]}], ")"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "+", 
                  RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}], "+", 
               RowBox[{
                RowBox[{"dNew", "^", "2"}], "/", "4"}]}], ")"}], "^", 
             "2"}]}]}], "+", 
          RowBox[{"dVal", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "+", 
                RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"dVal", "^", "2"}], "/", "4"}]}], ")"}]}]}], ")"}]}], 
       "]"}], "^", "2"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"analizzaStato", "[", 
      RowBox[{"cVal_", ",", "dVal_", ",", "dNew_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "eqX", ",", "solRawX", ",", "solValideX", ",", "numX", ",", "eqY", ",",
          "solRawY", ",", "solValideY", ",", 
         RowBox[{"posRoots", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"distSep", "=", 
          RowBox[{"Missing", "[", "]"}]}], ",", 
         RowBox[{"distX", "=", 
          RowBox[{"Missing", "[", "]"}]}], ",", "yMax", ",", "yMin", ",", 
         RowBox[{"distYTopMax", "=", 
          RowBox[{"Missing", "[", "]"}]}], ",", 
         RowBox[{"distYTopMin", "=", 
          RowBox[{"Missing", "[", "]"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"eqX", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"cVal", "-", 
             RowBox[{"cVal", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "*", 
                  RowBox[{"x", "^", "2"}]}], "-", 
                 RowBox[{
                  RowBox[{"dNew", "^", "2"}], "/", "2"}]}], ")"}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"x", "^", "2"}], "+", 
                  RowBox[{
                   RowBox[{"dNew", "^", "2"}], "/", "4"}]}], ")"}], "^", 
                "2"}]}]}], "+", 
             RowBox[{"dVal", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x", "^", "2"}], "+", 
                RowBox[{
                 RowBox[{"dVal", "^", "2"}], "/", "4"}]}], ")"}]}]}], ")"}], "^",
            "2"}], "==", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"solRawX", "=", 
         RowBox[{"x", "/.", " ", 
          RowBox[{"Quiet", "[", 
           RowBox[{
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"eqX", "&&", 
               RowBox[{
                RowBox[{"-", "30"}], "<=", "x", "<=", "30"}]}], ",", "x", ",",
               "Reals"}], "]"}], ",", 
            RowBox[{"NSolve", "::", "ratnz"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"ListQ", "[", "solRawX", "]"}]}], ",", 
          RowBox[{"solRawX", "=", 
           RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"solValideX", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"solRawX", ",", "NumericQ"}], "]"}], ",", "0.01"}], 
            "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numX", "=", 
         RowBox[{"Length", "[", "solValideX", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"eqY", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"cVal", "+", 
             RowBox[{"cVal", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "*", 
                  RowBox[{"y", "^", "2"}]}], "+", 
                 RowBox[{
                  RowBox[{"dNew", "^", "2"}], "/", "2"}]}], ")"}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"dNew", "^", "2"}], "/", "4"}], "-", 
                  RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}]}]}], "+", 
             RowBox[{"dVal", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"dVal", "^", "2"}], "/", "4"}], "-", 
                RowBox[{"y", "^", "2"}]}], ")"}]}]}], ")"}], "^", "2"}], "==",
           "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"solRawY", "=", 
         RowBox[{"y", "/.", " ", 
          RowBox[{"Quiet", "[", 
           RowBox[{
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"eqY", "&&", 
               RowBox[{
                RowBox[{"-", "30"}], "<=", "y", "<=", "30"}]}], ",", "y", ",",
               "Reals"}], "]"}], ",", 
            RowBox[{"NSolve", "::", "ratnz"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"ListQ", "[", "solRawY", "]"}]}], ",", 
          RowBox[{"solRawY", "=", 
           RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"solValideY", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"solRawY", ",", "NumericQ"}], "]"}], ",", "0.01"}], 
            "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"posRoots", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"solValideY", ",", 
            RowBox[{
             RowBox[{"#", ">", "0"}], "&"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "posRoots", "]"}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{"yMax", "=", 
            RowBox[{"Max", "[", "posRoots", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"distYTopMax", "=", 
            RowBox[{"Abs", "[", 
             RowBox[{"yMax", "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"dNew", "/", "2"}], "+", "1"}], ")"}]}], "]"}]}], 
           ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numX", "==", "0"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "posRoots", "]"}], ">", "0"}], ",", 
             RowBox[{
              RowBox[{"distSep", "=", 
               RowBox[{"2", "*", 
                RowBox[{"Min", "[", "posRoots", "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"yMin", "=", 
               RowBox[{"Min", "[", "posRoots", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"distYTopMin", "=", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"dNew", "/", "2"}], "-", "1"}], ")"}], "-", 
                 "yMin"}], "]"}]}], ";"}]}], "]"}], ";"}], ",", 
          RowBox[{
           RowBox[{"distX", "=", 
            RowBox[{
             RowBox[{"Max", "[", "solValideX", "]"}], "-", 
             RowBox[{"Min", "[", "solValideX", "]"}]}]}], ";"}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "numX", ",", "distSep", ",", "distX", ",", "posRoots", ",", 
          "distYTopMax", ",", "distYTopMin"}], "}"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"analizzaPuntoCompleto", "[", 
      RowBox[{"cVal_", ",", "dVal_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "statoBase", ",", "numXBase", ",", "posRootsBase", ",", "yMax", ",", 
         "yMin", ",", "dCorr", ",", "statoCorr", ",", "resBase", ",", 
         "resCorr", ",", "areaBase", ",", "areaCorr"}], "}"}], ",", 
       RowBox[{
        RowBox[{"statoBase", "=", 
         RowBox[{"analizzaStato", "[", 
          RowBox[{"cVal", ",", "dVal", ",", "dVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numXBase", "=", 
         RowBox[{"statoBase", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"posRootsBase", "=", 
         RowBox[{"statoBase", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"areaBase", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"2", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{"Boole", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"x", "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"y", "-", 
                    RowBox[{"dVal", "/", "2"}]}], ")"}], "^", "2"}]}], "<=", 
                "1"}], "&&", 
               RowBox[{
                RowBox[{"velSq", "[", 
                 RowBox[{
                 "x", ",", "y", ",", "cVal", ",", "dVal", ",", "dVal"}], 
                 "]"}], ">=", "1"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", 
               RowBox[{
                RowBox[{"dVal", "/", "2"}], "-", "1"}], ",", 
               RowBox[{
                RowBox[{"dVal", "/", "2"}], "+", "1"}]}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "3"}], ",", 
             RowBox[{"AccuracyGoal", "->", "3"}], ",", 
             RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"resBase", "=", 
         RowBox[{"{", 
          RowBox[{"cVal", ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "5", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "6", "]"}], "]"}], ",", "areaBase"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
