             RowBox[{"cVal", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "*", 
                  RowBox[{"y", "^", "2"}]}], "+", 
                 RowBox[{
                  RowBox[{"dNew", "^", "2"}], "/", "2"}]}], ")"}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"dNew", "^", "2"}], "/", "4"}], "-", 
                  RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}]}]}], "+", 
             RowBox[{"dVal", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"dVal", "^", "2"}], "/", "4"}], "-", 
                RowBox[{"y", "^", "2"}]}], ")"}]}]}], ")"}], "^", "2"}], "==",
           "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"solRawY", "=", 
         RowBox[{"y", "/.", " ", 
