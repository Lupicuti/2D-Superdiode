                   RowBox[{"PrecisionGoal", "->", "3"}], ",", 
                   RowBox[{"AccuracyGoal", "->", "3"}], ",", 
                   RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], 
                  "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"resCorr", "=", 
               RowBox[{"{", 
                RowBox[{"cVal", ",", 
                 RowBox[{"statoCorr", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"statoCorr", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", 
                 RowBox[{"statoCorr", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], ",", 
                 RowBox[{"statoCorr", "[", 
                  RowBox[{"[", "5", "]"}], "]"}], ",", 
                 RowBox[{"statoCorr", "[", 
                  RowBox[{"[", "6", "]"}], "]"}], ",", "areaCorr"}], "}"}]}], 
