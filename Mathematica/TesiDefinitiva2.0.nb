            RowBox[{"(", 
             RowBox[{"vel", "[", 
              RowBox[{"0", ",", "#"}], "]"}], ")"}], "-", "1"}], "]"}], "<", 
          "0.001"}], "&"}]}], "]"}]}], ";", "\n", 
     RowBox[{"soluzioni", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"N", "[", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"soluzioni", ",", "0.0001"}], "]"}], "]"}], "]"}], "]"}]}], 
     ";", "\n", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "3.", " ", "Filtriamo", " ", "SOLO", " ", "le", " ", "soluzioni", " ", 
       "strettamente", " ", "positive", " ", 
       RowBox[{"(", 
        RowBox[{"y", ">", "0"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"solPositive", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"soluzioni", ",", 
        RowBox[{
         RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", "\n", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"4.", " ", "Calcoli", " ", "e", " ", "Stampe"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "solPositive", "]"}], ">=", "2"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"bordoSup", ",", "bordoInf"}], "}"}], ",", 
         RowBox[{
          RowBox[{"yMax", "=", 
           RowBox[{"Max", "[", "solPositive", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"yMin", "=", 
           RowBox[{"Min", "[", "solPositive", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"bordoSup", "=", 
           RowBox[{
            RowBox[{"dcorrect", "/", "2"}], "+", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"bordoInf", "=", 
           RowBox[{
            RowBox[{"dcorrect", "/", "2"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Variabili", " ", "globali", " ", "per", " ", "dist1", " ", "e", " ",
             "dist2", " ", "mantenute"}], "*)"}], 
          RowBox[{"dist1", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{"bordoSup", "-", "yMax"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"dist2", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{"bordoInf", "-", "yMin"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<\\n=== RISULTATI ANALISI (c=\>\"", "<>", 
              RowBox[{"ToString", "[", "cval", "]"}], 
              "<>", "\"\<, dcorrect=\>\"", "<>", 
              RowBox[{"ToString", "[", "dcorrect", "]"}], 
              "<>", "\"\<) ===\>\""}], ",", "14", ",", "Bold", ",", 
             RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Soluzioni positive valide per y: \>\"", "<>", 
              RowBox[{"ToString", "[", "solPositive", "]"}]}], ",", "12"}], 
            "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Le", " ", "stringhe", " ", "ora", " ", "stampano", " ", "i", " ", 
            "bordi", " ", "calcolati", " ", "dinamicamente", " ", "basati", " ",
             "sul", " ", "nuovo", " ", "dcorrect"}], "*)"}], 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Distanza (Bordo Superiore - yMax):\>\"", ",", "12", 
              ",", "Bold"}], "]"}], ",", "\"\< |\>\"", ",", "bordoSup", 
            ",", "\"\< - \>\"", ",", "yMax", ",", "\"\<| = \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"dist1", ",", "14", ",", 
              RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Distanza (Bordo Inferiore - yMin):\>\"", ",", "12", 
              ",", "Bold"}], "]"}], ",", "\"\< |\>\"", ",", "bordoInf", 
            ",", "\"\< - \>\"", ",", "yMin", ",", "\"\<| = \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"dist2", ",", "14", ",", 
              RowBox[{"Darker", "[", "Red", "]"}], ",", "Bold"}], "]"}]}], 
           "]"}], ";"}]}], "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          
          RowBox[{"\"\<\\nAttenzione: Trovate meno di 2 soluzioni positive: \
\>\"", "<>", 
           RowBox[{"ToString", "[", "solPositive", "]"}]}], ",", "12", ",", 
          "Red"}], "]"}], "]"}]}], "]"}]}], "*)"}]}]}]], "Input",
