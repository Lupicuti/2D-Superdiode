pi\[UGrave] di tempo)\>\"", ",", "11", ",", "Italic", ",", "Gray"}], "]"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Esecuzione", " ", "Calcolo", " ", "Massivo"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datiCompleti3", "=", 
