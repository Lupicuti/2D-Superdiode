    RowBox[{"(", 
     RowBox[{"x", ",", "y"}], ")"}], " ", "dai", " ", "grafici"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"estraiPunti", "[", "plot_", "]"}], ":=", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "plot", "]"}], ",", 
       RowBox[{
        RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Ostacolo", " ", "standard"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ostacoloStandard", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FaceForm", "[", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
       RowBox[{"AbsoluteThickness", "[", "1.5", "]"}], ",", "Green", ",", 
       RowBox[{"Circle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}]}], "}"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"MACRO", " ", 
     RowBox[{"FUNZIONE", ":", 
      RowBox[{
      "Assegna", " ", "correttamente", " ", "in", " ", "modo", " ", "globale",
        " ", "le", " ", "derivate", " ", "e", " ", "le", " ", 
       "funzioni"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ImpostaFisica", "[", "wExpr_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "derivataZ", ",", "exprWRe", ",", "exprWIm", ",", "exprU", ",", 
         "exprV"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Pulisce", " ", "x"}], ",", "y", ",", 
         RowBox[{
         "z", " ", "e", " ", "c", " ", "per", " ", "evitare", " ", "che", " ",
           "valori", " ", "residui", " ", "inquinino", " ", 
          RowBox[{"l", "'"}], "algebra"}]}], "*)"}], 
       RowBox[{
        RowBox[{"Clear", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "c"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"derivataZ", "=", 
         RowBox[{"D", "[", 
          RowBox[{"wExpr", ",", "z"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"OTTIMIZZAZIONE", " ", "1"}], ":", 
          RowBox[{"Simplify", ".", "ComplexExpand"}]}], "*)"}], 
        RowBox[{"exprWRe", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"wExpr", "/.", " ", 
             RowBox[{"z", "->", 
              RowBox[{"x", "+", 
               RowBox[{"I", "*", "y"}]}]}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exprWIm", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Im", "[", 
            RowBox[{"wExpr", "/.", " ", 
             RowBox[{"z", "->", 
              RowBox[{"x", "+", 
               RowBox[{"I", "*", "y"}]}]}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exprU", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Im", "[", 
            RowBox[{"derivataZ", "/.", " ", 
             RowBox[{"z", "->", 
              RowBox[{"x", "+", 
               RowBox[{"I", "*", "y"}]}]}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exprV", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"derivataZ", "/.", " ", 
             RowBox[{"z", "->", 
              RowBox[{"x", "+", 
               RowBox[{"I", "*", "y"}]}]}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wRe", "[", 
          RowBox[{"x_", ",", "y_"}], "]"}], "=", "exprWRe"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wIm", "[", 
          RowBox[{"x_", ",", "y_"}], "]"}], "=", "exprWIm"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x_", ",", "y_"}], "]"}], "=", "exprU"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"x_", ",", "y_"}], "]"}], "=", "exprV"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
