         RowBox[{"Simplify", "[", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"exprU", "^", "2"}], "+", 
            RowBox[{"exprV", "^", "2"}]}], "]"}], "]"}]}], ";"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"MACRO", " ", 
