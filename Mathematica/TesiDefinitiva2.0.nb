Cell[CellGroupData[{

Cell["Senza approssimazione", "Subsubsection",
 CellChangeTimes->{{3.9843004563016224`*^9, 
  3.9843004611275406`*^9}},ExpressionUUID->"6d32aadf-6cf2-5746-af10-\
627b498d8eaf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"equazione", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", "*", "cval", "*", "y"}]}], ")"}]}], "+", 
      RowBox[{"2", "*", "cval", "*", "y"}], "-", 
      RowBox[{
       RowBox[{"cval", "^", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}], "-", 
          RowBox[{"2", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "^", "2"}], "-", 
             RowBox[{"y", "^", "2"}]}], ")"}]}], "+", "1"}], ")"}], ")"}]}]}],
      ")"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Risoluzione", " ", "esatta", " ", "e", " ", "analitica", " ", 
    "limitata", " ", "al", " ", "dominio", " ", "dei", " ", "numeri", " ", 
    "Reali"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Assumendo", " ", "che", " ", "il", " ", 
    RowBox[{"parametro", "'"}], 
    RowBox[{"c", "'"}], " ", "appartenga", " ", "ai", " ", "reali"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"soluzioni", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"equazione", "/.", " ", 
         RowBox[{"x", "->", "0"}]}], ")"}], "==", "0"}], ",", "y", ",", 
      "Reals"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Estrazione", " ", "dei", " ", "soli", " ", "valori", " ", 
    "reali", " ", "di", " ", "y"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valoriReali", "=", 
    RowBox[{"y", "/.", " ", "soluzioni"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Selezione", " ", "del", " ", "minimo", " ", "e", " ", "del", " ",
     "massimo"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", 
   RowBox[{"Min", "[", "valoriReali", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y4", "=", 
    RowBox[{"Max", "[", "valoriReali", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Radici reali esatte trovate: \>\"", ",", "valoriReali"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Soluzione reale pi\[UGrave] piccola: \>\"", ",", "y1"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Soluzione reale pi\[UGrave] grande: \>\"", ",", "y4"}], "]"}],
   ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
  3.984300489904869*^9, 3.9843014771050797`*^9, {3.984301650903343*^9, 
   3.984301655111614*^9}, {3.984302056493332*^9, 3.9843020583757534`*^9}, {
   3.984302090728567*^9, 3.98430212869046*^9}, 3.9843022429037724`*^9, {
