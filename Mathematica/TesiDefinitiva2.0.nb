           "\[IndentingNewLine]", 
           RowBox[{"distYTopMax", "=", 
            RowBox[{"Abs", "[", 
             RowBox[{"yMax", "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"dNew", "/", "2"}], "+", "1"}], ")"}]}], "]"}]}], 
           ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numX", "==", "0"}], ",", 
