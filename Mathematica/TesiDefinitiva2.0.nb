             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", 
               RowBox[{
                RowBox[{"dVal", "/", "2"}], "-", "1"}], ",", 
               RowBox[{
                RowBox[{"dVal", "/", "2"}], "+", "1"}]}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "3"}], ",", 
             RowBox[{"AccuracyGoal", "->", "3"}], ",", 
             RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"resBase", "=", 
         RowBox[{"{", 
          RowBox[{"cVal", ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "5", "]"}], "]"}], ",", 
           RowBox[{"statoBase", "[", 
            RowBox[{"[", "6", "]"}], "]"}], ",", "areaBase"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numXBase", "==", "0"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "posRootsBase", "]"}], ">=", "2"}], ",", 
             RowBox[{
              RowBox[{"yMin", "=", 
               RowBox[{"Min", "[", "posRootsBase", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                 RowBox[{"--", 
                  RowBox[{"-", "UNICO"}]}], " ", 
                 RowBox[{"FEEDBACK", ":", "dNew"}]}], "=", 
                RowBox[{
                 RowBox[{"2", "*", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"yMin", "+", "1"}], ")"}], "--"}]}], "-"}]}], 
               "*)"}], 
              RowBox[{"dCorr", "=", 
               RowBox[{"2", "*", 
                RowBox[{"(", 
                 RowBox[{"yMin", "+", "1"}], ")"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"statoCorr", "=", 
               RowBox[{"analizzaStato", "[", 
                RowBox[{"cVal", ",", "dVal", ",", "dCorr"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"areaCorr", "=", 
               RowBox[{"Quiet", "[", 
                RowBox[{"2", "*", 
                 RowBox[{"NIntegrate", "[", 
                  RowBox[{
                   RowBox[{"Boole", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "^", "2"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"y", "-", 
                    RowBox[{"dCorr", "/", "2"}]}], ")"}], "^", "2"}]}], "<=", 
                    "1"}], "&&", 
                    RowBox[{
                    RowBox[{"velSq", "[", 
                    RowBox[{
                    "x", ",", "y", ",", "cVal", ",", "dVal", ",", "dCorr"}], 
                    "]"}], ">=", "1"}]}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"y", ",", 
                    RowBox[{
                    RowBox[{"dCorr", "/", "2"}], "-", "1"}], ",", 
                    RowBox[{
