Cell["Caso con Linee Separate", "Subsection",
 CellChangeTimes->{{3.9843253675667763`*^9, 
  3.9843253839044876`*^9}},ExpressionUUID->"60079112-409b-164e-a990-\
08fe7ba28442"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"c", ",", "cval", ",", "d", ",", "y"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cval", "=", " ", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d", "=", "8"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Inizializza", " ", "la", " ", "fisica", " ", 
    RowBox[{"(", 
     RowBox[{
     "c", " ", "viene", " ", "trattato", " ", "come", " ", "parametro", " ", 
      "simbolico"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ImpostaFisica", "[", 
    RowBox[{
     RowBox[{"I", "*", "c", "*", 
      RowBox[{"(", 
       RowBox[{"z", "+", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"z", "-", 
           RowBox[{"I", "*", 
            RowBox[{"d", "/", "2"}]}]}], ")"}]}], "+", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"z", "+", 
           RowBox[{"I", "*", 
            RowBox[{"d", "/", "2"}]}]}], ")"}]}]}], ")"}]}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"z", "-", 
       RowBox[{"I", "*", 
        RowBox[{"d", "/", "2"}]}]}], "]"}], "-", 
     RowBox[{"Log", "[", 
      RowBox[{"z", "+", 
       RowBox[{"I", "*", 
        RowBox[{"d", "/", "2"}]}]}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Stampa", " ", "i", " ", "grafici", " ", "usando", " ", "la", " ", "tua", " ",
     "macro", " ", "originale"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StampaGrafici", "[", 
    RowBox[{
    "ostacoloDoppio", 
     ",", "\"\<=== CASO CON LINEE SEPARATE (Senza Correzione) ===\>\"", ",", 
     "d", ",", \
"\"\<C:\\\\Users\\\\franc\\\\OneDrive\\\\Documenti\\\\Universit\[AGrave]\\\\\
Tesi\\\\Wolfram\>\"", ",", "\"\<linsep_nocorr\>\"", ",", "cval"}], "]"}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Calcoliamo", " ", "TUTTE", " ", "le", " ", "soluzioni", " ", 
    "per", " ", "y", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"con", " ", "x"}], "=", "0"}], ")"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Usa", " ", "la", " ", "regola", " ", "di", " ", "sostituzione", " ", 
     RowBox[{"(", 
      RowBox[{"/.", " ", 
       RowBox[{"c", "->", "cval"}]}], ")"}], " ", "invece", " ", "di", " ", 
     "assegnare", " ", "c"}], "=", "cval"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Questo", " ", 
    RowBox[{"mantiene", "'"}], 
    RowBox[{"c", "'"}], " ", "come", " ", "simbolo", " ", "globale", " ", 
    "intatto", " ", "per", " ", "cicli", " ", "futuri"}], "*)"}], 
  RowBox[{
   RowBox[{"soluzioni", "=", 
    RowBox[{"y", "/.", " ", 
     RowBox[{"Quiet", "[", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"vel", "[", 
             RowBox[{"0", ",", "y"}], "]"}], "/.", " ", 
            RowBox[{"c", "->", "cval"}]}], ")"}], "==", "1"}], "&&", 
         RowBox[{
          RowBox[{"-", "30"}], "<=", "y", "<=", "30"}]}], ",", "y", ",", 
        "Reals"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Protezione", " ", "nel", " ", "caso", " ", "NSolve", " ", "non", " ", 
    "trovi", " ", "soluzioni", " ", "reali"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"ListQ", "[", "soluzioni", "]"}]}], ",", 
     RowBox[{"soluzioni", "=", 
      RowBox[{"{", "}"}]}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"soluzioni", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", "soluzioni", "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"soluzioni", "=", 
    RowBox[{"Re", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"soluzioni", ",", "NumericQ"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Controllo", " ", "validit\[AGrave]", " ", "usando", " ", "la", " ", 
    "sostituzione"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"soluzioni", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"soluzioni", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"vel", "[", 
            RowBox[{"0", ",", "#"}], "]"}], "/.", " ", 
           RowBox[{"c", "->", "cval"}]}], ")"}], "-", "1"}], "]"}], "<", 
       "0.001"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"soluzioni", "=", 
    RowBox[{"Sort", "[", 
     RowBox[{"N", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Round", "[", 
        RowBox[{"soluzioni", ",", "0.0001"}], "]"}], "]"}], "]"}], "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Filtriamo", " ", "SOLO", " ", "le", " ", "soluzioni", " ", 
    "strettamente", " ", "positive", " ", 
    RowBox[{"(", 
     RowBox[{"y", ">", "0"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solPositive", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"soluzioni", ",", 
      RowBox[{
       RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"4.", " ", "Calcoli", " ", "e", " ", "Stampe"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Length", "[", "solPositive", "]"}], ">=", "2"}], ",", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bordoSup", ",", "bordoInf"}], "}"}], ",", 
     RowBox[{
      RowBox[{"yMax", "=", 
       RowBox[{"Max", "[", "solPositive", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"yMin", "=", 
       RowBox[{"Min", "[", "solPositive", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bordoSup", "=", 
       RowBox[{
        RowBox[{"d", "/", "2"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bordoInf", "=", 
       RowBox[{
        RowBox[{"d", "/", "2"}], "-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Variabili", " ", "globali", " ", "per", " ", "dist1", " ", "e", " ", 
        "dist2", " ", "mantenute"}], "*)"}], 
      RowBox[{"dist1", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"bordoSup", "-", "yMax"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dist2", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"bordoInf", "-", "yMin"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"\"\<\\n=== RISULTATI ANALISI (c=\>\"", "<>", 
          RowBox[{"ToString", "[", "cval", "]"}], "<>", "\"\<, d=\>\"", "<>", 
          RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<) ===\>\""}], ",", 
         "14", ",", "Bold", ",", 
         RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"\"\<Soluzioni positive valide per y: \>\"", "<>", 
          RowBox[{"ToString", "[", "solPositive", "]"}]}], ",", "12"}], "]"}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Correzione", ":", 
        RowBox[{
         RowBox[{
         "usiamo", " ", "le", " ", "variabili", " ", "al", " ", "posto", " ", 
          "dei", " ", "numeri", " ", "hard"}], "-", "coded"}]}], "*)"}], 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Distanza (Bordo Superiore - yMax):\>\"", ",", "12", ",",
           "Bold"}], "]"}], ",", "\"\< |\>\"", ",", "bordoSup", 
        ",", "\"\< - \>\"", ",", "yMax", ",", "\"\<| = \>\"", ",", 
        RowBox[{"Style", "[", 
         RowBox[{"dist1", ",", "14", ",", 
          RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Distanza (Bordo Inferiore - yMin):\>\"", ",", "12", ",",
           "Bold"}], "]"}], ",", "\"\< |\>\"", ",", "bordoInf", 
        ",", "\"\< - \>\"", ",", "yMin", ",", "\"\<| = \>\"", ",", 
        RowBox[{"Style", "[", 
         RowBox[{"dist2", ",", "14", ",", 
          RowBox[{"Darker", "[", "Red", "]"}], ",", "Bold"}], "]"}]}], "]"}], 
      ";"}]}], "]"}], ",", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<\\nAttenzione: Trovate meno di 2 soluzioni positive: \>\"",
        "<>", 
