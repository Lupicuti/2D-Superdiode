            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"eqY", "&&", 
               RowBox[{
                RowBox[{"-", "30"}], "<=", "y", "<=", "30"}]}], ",", "y", ",",
               "Reals"}], "]"}], ",", 
            RowBox[{"NSolve", "::", "ratnz"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
