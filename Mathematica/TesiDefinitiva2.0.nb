  3.9843704071933002`*^9}},ExpressionUUID->"46f955bc-a760-e74a-ab66-\
445ae24e50e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "CASO", " ", "CON", " ", "CORREZIONE", " ", "DELLA", " ", "DISTANZA", " ", 
    RowBox[{"(", "dcorrect", ")"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"dcorrect", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"yMax", "+", "yMin", "+", "d"}], ")"}], "/", "2"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{
    "Uso", " ", "la", " ", "media", " ", "tra", " ", "la", " ", "distanza", " ",
      "di", " ", "prima", " ", "e", " ", "la", " ", "nuova", " ", 
     "corretta"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ostacoloDoppio", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FaceForm", "[", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"-", "dcorrect"}], "/", "2"}]}], "}"}], ",", "1"}], "]"}],
        ",", 
       RowBox[{"AbsoluteThickness", "[", "1.5", "]"}], ",", "Green", ",", 
       RowBox[{"Circle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"-", "dcorrect"}], "/", "2"}]}], "}"}], ",", "1"}], "]"}],
        ",", 
       RowBox[{"FaceForm", "[", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"+", "dcorrect"}], "/", "2"}]}], "}"}], ",", "1"}], "]"}],
        ",", 
       RowBox[{"AbsoluteThickness", "[", "1.5", "]"}], ",", "Green", ",", 
       RowBox[{"Circle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"dcorrect", "/", "2"}]}], "}"}], ",", "1"}], "]"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Inizializza", " ", "la", " ", "fisica", " ", 
     RowBox[{"(", 
      RowBox[{
      "c", " ", "viene", " ", "trattato", " ", "come", " ", "parametro", " ", 
       "simbolico"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ImpostaFisica", "[", 
     RowBox[{
      RowBox[{"I", "*", "c", "*", 
       RowBox[{"(", 
        RowBox[{"z", "+", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"z", "-", 
            RowBox[{"I", "*", 
             RowBox[{"dcorrect", "/", "2"}]}]}], ")"}]}], "+", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"z", "+", 
            RowBox[{"I", "*", 
             RowBox[{"dcorrect", "/", "2"}]}]}], ")"}]}]}], ")"}]}], "+", 
      RowBox[{"Log", "[", 
       RowBox[{"z", "-", 
        RowBox[{"I", "*", 
         RowBox[{"d", "/", "2"}]}]}], "]"}], "-", 
      RowBox[{"Log", "[", 
       RowBox[{"z", "+", 
        RowBox[{"I", "*", 
         RowBox[{"d", "/", "2"}]}]}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"StampaGrafici", "[", 
     RowBox[{
     "ostacoloDoppio", 
      ",", "\"\<=== CASO CON LINEE SEPARATE (Con Correzione) ===\>\"", ",", 
      "dcorrect", 
      ",", "\"\<C:\\\\Users\\\\franc\\\\OneDrive\\\\Documenti\\\\Universit\
\[AGrave]\\\\Tesi\\\\Wolfram\>\"", ",", "\"\<linsep_corrmed\>\"", ",", 
      "cval"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
        "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
       "===", "===", "==="}], "=", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "2.", " ", "Calcoliamo", " ", "TUTTE", " ", "le", " ", "soluzioni", " ",
         "per", " ", "y", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"con", " ", "x"}], "=", "0"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
         "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
          "===", "===", "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", "cval"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "Assegniamo", " ", "il", " ", "valore", " ", "a", " ", "c", " ", "per", 
       " ", "la", " ", "valutazione", " ", "numerica"}], "*)"}], 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"soluzioni", "=", 
      RowBox[{"y", "/.", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"vel", "[", 
             RowBox[{"0", ",", "y"}], "]"}], "==", "1"}], "&&", 
           RowBox[{
            RowBox[{"-", "30"}], "<=", "y", "<=", "30"}]}], ",", "y", ",", 
          "Reals"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "Protezione", " ", "nel", " ", "caso", " ", "NSolve", " ", "fallisca", " ",
        "o", " ", "non", " ", "trovi", " ", "soluzioni"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListQ", "[", "soluzioni", "]"}]}], ",", 
       RowBox[{"soluzioni", "=", 
        RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", "\n", 
     RowBox[{"soluzioni", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", "soluzioni", "}"}], "]"}]}], ";", "\n", 
     RowBox[{"soluzioni", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"Select", "[", 
        RowBox[{"soluzioni", ",", "NumericQ"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"soluzioni", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"soluzioni", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"vel", "[", 
              RowBox[{"0", ",", "#"}], "]"}], ")"}], "-", "1"}], "]"}], "<", 
          "0.001"}], "&"}]}], "]"}]}], ";", "\n", 
     RowBox[{"soluzioni", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"N", "[", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"soluzioni", ",", "0.0001"}], "]"}], "]"}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "3.", " ", "Filtriamo", " ", "SOLO", " ", "le", " ", "soluzioni", " ", 
       "strettamente", " ", "positive", " ", 
       RowBox[{"(", 
        RowBox[{"y", ">", "0"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"solPositive", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"soluzioni", ",", 
        RowBox[{
         RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", 
      RowBox[{"4.", " ", "Calcoli", " ", "e", " ", "Stampe"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "solPositive", "]"}], ">=", "2"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"bordoSup", ",", "bordoInf"}], "}"}], ",", 
         RowBox[{
          RowBox[{"yMax1", "=", 
           RowBox[{"Max", "[", "solPositive", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"yMin1", "=", 
           RowBox[{"Min", "[", "solPositive", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"bordoSup", "=", 
           RowBox[{
            RowBox[{"dcorrect", "/", "2"}], "+", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"bordoInf", "=", 
           RowBox[{
            RowBox[{"dcorrect", "/", "2"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Variabili", " ", "globali", " ", "per", " ", "dist1", " ", "e", " ",
             "dist2", " ", "mantenute"}], "*)"}], 
          RowBox[{"dist1", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{"bordoSup", "-", "yMax1"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"dist2", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{"bordoInf", "-", "yMin1"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<\\n=== RISULTATI ANALISI (c=\>\"", "<>", 
              RowBox[{"ToString", "[", "cval", "]"}], 
              "<>", "\"\<, dcorrect=\>\"", "<>", 
              RowBox[{"ToString", "[", "dcorrect", "]"}], 
              "<>", "\"\<) ===\>\""}], ",", "14", ",", "Bold", ",", 
             RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Soluzioni positive valide per y: \>\"", "<>", 
              RowBox[{"ToString", "[", "solPositive", "]"}]}], ",", "12"}], 
            "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Le", " ", "stringhe", " ", "ora", " ", "stampano", " ", "i", " ", 
            "bordi", " ", "calcolati", " ", "dinamicamente"}], "*)"}], 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Distanza (Bordo Superiore - yMax):\>\"", ",", "12", 
              ",", "Bold"}], "]"}], ",", "\"\< |\>\"", ",", "bordoSup", 
            ",", "\"\< - \>\"", ",", "yMax1", ",", "\"\<| = \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"dist1", ",", "14", ",", 
              RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Distanza (Bordo Inferiore - yMin):\>\"", ",", "12", 
              ",", "Bold"}], "]"}], ",", "\"\< |\>\"", ",", "bordoInf", 
            ",", "\"\< - \>\"", ",", "yMin1", ",", "\"\<| = \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"dist2", ",", "14", ",", 
              RowBox[{"Darker", "[", "Red", "]"}], ",", "Bold"}], "]"}]}], 
           "]"}], ";"}]}], "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          
          RowBox[{"\"\<\\nAttenzione: Trovate meno di 2 soluzioni positive: \
\>\"", "<>", 
           RowBox[{"ToString", "[", "solPositive", "]"}]}], ",", "12", ",", 
          "Red"}], "]"}], "]"}]}], "]"}]}], "*)"}]}]}]], "Input",
