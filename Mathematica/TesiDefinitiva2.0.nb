   RowBox[{"(*", 
    RowBox[{
     RowBox[{"PARTE", " ", "1"}], ":", 
     RowBox[{
     "PARAMETRI", " ", "GLOBALI", " ", "E", " ", "MOTORE", " ", "DI", " ", 
      "CALCOLO"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "==="}], "="}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valoriD", "=", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "1.5", ",", "2", ",", "2.5", ",", "3", ",", "3.5", ",", "4", ",",
        "4.5", ",", "5", ",", "5.5", ",", "6", ",", "6.5", ",", "7", ",", 
       "7.5", ",", "8", ",", "8.5", ",", "9", ",", "9.5", ",", "10", ",", 
       "10.5", ",", "11", ",", "11.5", ",", "12", ",", "12.5", ",", "13", ",",
        "13.5", ",", "14", ",", "14.5", ",", "15"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stepDistanza", "=", "0.005"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Usa", " ", "0.01", " ", "per", " ", "test", " ", "veloci"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"rangeC", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1", ",", "stepDistanza"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Definizioni", " ", "Funzioni"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"df", "[", 
      RowBox[{"z_", ",", "c_", ",", "d_"}], "]"}], ":=", 
     RowBox[{"I", "*", 
      RowBox[{"(", 
       RowBox[{"c", "-", 
        RowBox[{"c", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", 
             RowBox[{"z", "^", "2"}]}], "-", 
            RowBox[{
             RowBox[{"d", "^", "2"}], "/", "2"}]}], ")"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"z", "^", "2"}], "+", 
             RowBox[{
              RowBox[{"d", "^", "2"}], "/", "4"}]}], ")"}], "^", "2"}]}]}], "+", 
        RowBox[{"d", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"z", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"d", "^", "2"}], "/", "4"}]}], ")"}]}]}], ")"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"velSqExpr", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"df", "[", 
          RowBox[{
           RowBox[{"x", "+", 
            RowBox[{"I", "*", "y"}]}], ",", "c", ",", "d"}], "]"}], "]"}], "^",
         "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"velSq", "[", 
      RowBox[{"x_", ",", "y_", ",", "c_", ",", "d_"}], "]"}], "=", 
     "velSqExpr"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"velSq", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", "NumericQ"}], ",", 
       RowBox[{"c_", "?", "NumericQ"}], ",", 
       RowBox[{"dVal_", "?", "NumericQ"}], ",", 
       RowBox[{"dNew_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"I", "*", 
        RowBox[{"(", 
         RowBox[{"c", "-", 
          RowBox[{"c", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "+", 
                  RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}]}], "-", 
              RowBox[{
               RowBox[{"dNew", "^", "2"}], "/", "2"}]}], ")"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "+", 
                  RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}], "+", 
               RowBox[{
                RowBox[{"dNew", "^", "2"}], "/", "4"}]}], ")"}], "^", 
             "2"}]}]}], "+", 
          RowBox[{"dVal", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "+", 
                RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"dVal", "^", "2"}], "/", "4"}]}], ")"}]}]}], ")"}]}], 
       "]"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"analizzaStato", "[", 
      RowBox[{"cVal_", ",", "dVal_", ",", "dNew_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "eqX", ",", "solRawX", ",", "solValideX", ",", "numX", ",", "eqY", ",",
          "solRawY", ",", "solValideY", ",", 
         RowBox[{"posRoots", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"distSep", "=", 
          RowBox[{"Missing", "[", "]"}]}], ",", 
         RowBox[{"distX", "=", 
          RowBox[{"Missing", "[", "]"}]}], ",", "yMax", ",", "yMin", ",", 
         RowBox[{"distYTopMax", "=", 
          RowBox[{"Missing", "[", "]"}]}], ",", 
         RowBox[{"distYTopMin", "=", 
          RowBox[{"Missing", "[", "]"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"eqX", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"cVal", "-", 
             RowBox[{"cVal", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "*", 
                  RowBox[{"x", "^", "2"}]}], "-", 
                 RowBox[{
                  RowBox[{"dNew", "^", "2"}], "/", "2"}]}], ")"}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"x", "^", "2"}], "+", 
                  RowBox[{
                   RowBox[{"dNew", "^", "2"}], "/", "4"}]}], ")"}], "^", 
                "2"}]}]}], "+", 
             RowBox[{"dVal", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x", "^", "2"}], "+", 
                RowBox[{
                 RowBox[{"dVal", "^", "2"}], "/", "4"}]}], ")"}]}]}], ")"}], "^",
            "2"}], "==", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"solRawX", "=", 
         RowBox[{"x", "/.", " ", 
          RowBox[{"Quiet", "[", 
           RowBox[{
            RowBox[{"NSolve", "[", 
             RowBox[{
              RowBox[{"eqX", "&&", 
               RowBox[{
                RowBox[{"-", "30"}], "<=", "x", "<=", "30"}]}], ",", "x", ",",
               "Reals"}], "]"}], ",", 
            RowBox[{"NSolve", "::", "ratnz"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"ListQ", "[", "solRawX", "]"}]}], ",", 
          RowBox[{"solRawX", "=", 
           RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"solValideX", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"solRawX", ",", "NumericQ"}], "]"}], ",", "0.01"}], 
            "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numX", "=", 
         RowBox[{"Length", "[", "solValideX", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"eqY", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
