                  RowBox[{"dNew", "^", "2"}], "/", "2"}]}], ")"}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"dNew", "^", "2"}], "/", "4"}], "-", 
                  RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}]}]}], "+", 
             RowBox[{"dVal", "/", 
              RowBox[{"(", 
