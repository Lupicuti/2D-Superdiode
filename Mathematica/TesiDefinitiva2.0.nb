Cell[CellGroupData[{

Cell["Con approssimazione", "Subsubsection",
 CellChangeTimes->{{3.984300471082226*^9, 
  3.984300473785469*^9}},ExpressionUUID->"32e954ea-5b9e-a840-962a-\
ec00cf713999"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Analitico", " ", "Con", " ", "Approssimazione"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"equazioneApprox", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], ")"}], "^", "2"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "*", "cval", "*", "y"}]}], ")"}]}], "+", 
       RowBox[{"2", "*", "cval", "*", "y"}]}], ")"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1.", " ", "Risoluzione"}], ",", 
     RowBox[{
     "valutazione", " ", "numerica", " ", "e", " ", "azzeramento", " ", "dei",
       " ", "residui", " ", "infinitesimali"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"soluzioniApprox", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"equazioneApprox", "/.", " ", 
          RowBox[{"x", "->", "0"}]}], ")"}], "==", "0"}], ",", "y"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"valoriNumerici", "=", 
     RowBox[{"y", "/.", " ", 
      RowBox[{"Chop", "[", 
       RowBox[{"N", "[", "soluzioniApprox", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Filtro", " ", "per", " ", "mantenere", " ", "solo", " ", "le",
      " ", "radici", " ", "reali", " ", 
     RowBox[{"(", 
      RowBox[{"scarta", " ", "i", " ", "complessi", " ", "residui"}], ")"}]}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valoriRealiApprox", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"valoriNumerici", ",", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{"#", ",", "Complex"}], "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Selezione", " ", "del", " ", "minimo", " ", "e", " ", "del", " ",
      "massimo"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y1approx", "=", 
     RowBox[{"Min", "[", "valoriRealiApprox", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"y4approx", "=", 
     RowBox[{"Max", "[", "valoriRealiApprox", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Radici reali approssimate trovate: \>\"", ",", 
      "valoriRealiApprox"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Soluzione reale pi\[UGrave] piccola: \>\"", ",", 
      "y1approx"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Soluzione reale pi\[UGrave] grande: \>\"", ",", 
      "y4approx"}], "]"}], ";"}]}]}]], "Input",
