        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"resBase", ",", "resCorr"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
