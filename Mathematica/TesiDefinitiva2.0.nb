     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "cCrit", "}"}], ",", 
           RowBox[{
            RowBox[{"cCrit", "=", 
             RowBox[{"SelectFirst", "[", 
              RowBox[{
               RowBox[{"datiCorr2", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"MissingQ", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], "||", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"NumericQ", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "&&", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ">=", "2"}]}], ")"}]}], 
                "&"}]}], "]"}]}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MissingQ", "[", "cCrit", "]"}], ",", 
              RowBox[{"Missing", "[", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"cCrit", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"valoriD", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "valoriD", "]"}]}], "}"}]}], "]"}], ",", 
       "_Missing"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   StyleBox["\"\<1. Avvio Calcolo Massivo Unificato Dipolo (Base + Feedback + \
