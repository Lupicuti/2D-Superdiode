            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"solRawY", ",", "NumericQ"}], "]"}], ",", "0.01"}], 
            "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"posRoots", "=", 
