   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"analizzaPuntoCompleto", "[", 
      RowBox[{"cVal_", ",", "dVal_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "statoBase", ",", "numXBase", ",", "posRootsBase", ",", "yMin", ",", 
         "dCorr", ",", "statoCorr", ",", "resBase", ",", "resCorr", ",", 
         "areaBase", ",", "areaCorr"}], "}"}], ",", 
       RowBox[{
        RowBox[{"statoBase", "=", 
         RowBox[{"analizzaStato", "[", 
          RowBox[{"cVal", ",", "dVal", ",", "dVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numXBase", "=", 
         RowBox[{"statoBase", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"posRootsBase", "=", 
         RowBox[{"statoBase", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"areaBase", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"2", "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{"Boole", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"x", "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"y", "-", 
                    RowBox[{"dVal", "/", "2"}]}], ")"}], "^", "2"}]}], "<=", 
                "1"}], "&&", 
               RowBox[{
                RowBox[{"velSq", "[", 
